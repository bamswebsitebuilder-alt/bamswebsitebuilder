rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocumentExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return userDocumentExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {

      // =====================================================
      // USER PROFILE
      // =====================================================

      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == "client"
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "firstName",
              "lastName",
              "fullName",
              "businessName",
              "phone",
              "email",
              "updatedAt",
              "lastMessage",
              "lastMessageAt",
              "unreadByAdmin",
              "unreadByClient"
            ])
        );

      allow delete: if isAdmin();


      match /agreements/{agreementId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isAdmin()
          && request.resource.data.state == "issued"
          && request.resource.data.issuedBy == request.auth.uid
          && request.resource.data.issuedAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.quoteNumber is string && request.resource.data.quoteNumber.size() > 0
          && request.resource.data.scope is string && request.resource.data.scope.size() > 0
          && request.resource.data.clientName is string && request.resource.data.clientName.size() > 0
          && request.resource.data.clientEmail is string
          && request.resource.data.providerName is string && request.resource.data.providerName.size() > 0
          && request.resource.data.projectName is string && request.resource.data.projectName.size() > 0
          && request.resource.data.paymentSchedule is string && request.resource.data.paymentSchedule.size() > 0
          && request.resource.data.delivery is string && request.resource.data.delivery.size() > 0
          && request.resource.data.ongoingCosts is string && request.resource.data.ongoingCosts.size() > 0
          && request.resource.data.revisions is int && request.resource.data.revisions >= 0
          && request.resource.data.termsVersion == "1-2026-10-10"
          && request.resource.data.termsText is string && request.resource.data.termsText.size() > 0;
        allow update: if isAdmin() && resource.data.state == "issued"
          && request.resource.data.state == "withdrawn"
          && request.resource.data.withdrawnAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["state", "withdrawnAt"])
          && !exists(/databases/$(database)/documents/users/$(userId)/agreements/$(agreementId)/acceptances/client);
        allow delete: if false;
        match /acceptances/{acceptanceId} {
          allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
          allow create: if signedIn() && request.auth.uid == userId
            && request.auth.token.email_verified == true && acceptanceId == "client"
            && request.resource.data.keys().hasOnly(["quoteId", "termsVersion", "name", "email", "clientUid", "statement", "acceptedAt"])
            && request.resource.data.quoteId == agreementId
            && request.resource.data.clientUid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.acceptedAt == request.time
            && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 150
            && request.resource.data.statement == "I accept this quote and its attached project terms."
            && request.resource.data.termsVersion == get(/databases/$(database)/documents/users/$(userId)/agreements/$(agreementId)).data.termsVersion
            && get(/databases/$(database)/documents/users/$(userId)/agreements/$(agreementId)).data.state == "issued"
            && get(/databases/$(database)/documents/users/$(userId)/agreements/$(agreementId)).data.expiresAt > request.time;
          allow update, delete: if false;
        }
      }
      // =====================================================
      // PROJECTS
      // =====================================================

      match /projects/{projectId} {

        allow read: if signedIn()
          && (
            request.auth.uid == userId
            || isAdmin()
          );

        allow create, update, delete: if isAdmin();
      }

      // =====================================================
      // INVOICES
      // =====================================================

      match /invoices/{invoiceId} {

        allow read: if signedIn()
          && (
            request.auth.uid == userId
            || isAdmin()
          );

        allow create, update, delete: if isAdmin();
      }

      // =====================================================
      // MESSAGES
      // =====================================================

      match /messages/{messageId} {

        // Client can read only their own conversation.
        // Admin can read every conversation.
        allow read: if signedIn()
          && (
            request.auth.uid == userId
            || isAdmin()
          );

        // Client or admin can send messages.
        allow create: if signedIn()
          && (
            request.auth.uid == userId
            || isAdmin()
          )
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.sender in ["client", "admin"];

        // Only allow read/seen status updates.
        allow update: if signedIn()
          && (
            request.auth.uid == userId
            || isAdmin()
          )
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "seen"
            ]);

        allow delete: if isAdmin();
      }

      // =====================================================
      // CLIENT FILE RECORDS
      // =====================================================

      match /files/{fileId} {

        allow read: if signedIn()
          && (
            request.auth.uid == userId
            || isAdmin()
          );

        allow create: if signedIn()
          && (
            request.auth.uid == userId
            || isAdmin()
          );

        allow update, delete: if isAdmin();
      }

      // =====================================================
      // NOTIFICATIONS
      // =====================================================

      match /notifications/{notificationId} {

        allow read: if signedIn()
          && (
            request.auth.uid == userId
            || isAdmin()
          );

        allow create: if isAdmin();

        allow update: if signedIn()
          && (
            request.auth.uid == userId
            || isAdmin()
          );

        allow delete: if isAdmin();
      }
    }
    // Climb the Coaching Ladder: separate staff roles and public league content.
    // Staff records must be provisioned by a trusted Firebase administrator.
    function isLeagueStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/coachingLadderStaff/$(request.auth.uid))
        && get(/databases/$(database)/documents/coachingLadderStaff/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/coachingLadderStaff/$(request.auth.uid)).data.role in ["commissioner", "staff"];
    }

    match /coachingLadderStaff/{staffUid} {
      allow read: if request.auth != null && request.auth.uid == staffUid;
      allow write: if false;
    }

    match /coachingLadder/{scope}/site/{documentId} {
      allow read: if scope == "public" && documentId == "content";
      allow create, update: if scope == "public" && documentId == "content"
        && isLeagueStaff()
        && request.resource.data.keys().hasOnly([
          "announcements", "breaking", "advancement", "scores", "champions",
          "format", "available", "taken", "recruiting", "rules", "tips",
          "playbooks", "creators", "highlights", "updatedAt", "updatedBy"
        ])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.announcements is list && request.resource.data.announcements.size() <= 40
        && request.resource.data.breaking is list && request.resource.data.breaking.size() <= 40
        && request.resource.data.advancement is list && request.resource.data.advancement.size() <= 40
        && request.resource.data.scores is list && request.resource.data.scores.size() <= 40
        && request.resource.data.champions is list && request.resource.data.champions.size() <= 40
        && request.resource.data.format is list && request.resource.data.format.size() <= 40
        && request.resource.data.available is list && request.resource.data.available.size() <= 40
        && request.resource.data.taken is list && request.resource.data.taken.size() <= 40
        && request.resource.data.recruiting is list && request.resource.data.recruiting.size() <= 40
        && request.resource.data.rules is list && request.resource.data.rules.size() <= 40
        && request.resource.data.tips is list && request.resource.data.tips.size() <= 40
        && request.resource.data.playbooks is list && request.resource.data.playbooks.size() <= 40
        && request.resource.data.creators is list && request.resource.data.creators.size() <= 40
        && request.resource.data.highlights is list && request.resource.data.highlights.size() <= 40;
      allow delete: if false;
    }

    // Payment and registrar state is exclusively managed through Firebase Admin.
    // Owners may read their own orders; no client SDK writes are permitted.
    match /domainOrders/{orderId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

  }
}
