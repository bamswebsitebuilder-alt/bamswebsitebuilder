        }
      ]
    },
    {
      "name": "Contact BAM's",
      "short_name": "Contact",
      "url": "/contact",
      "icons": [
        {
          "src": "/images/app-logo-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
